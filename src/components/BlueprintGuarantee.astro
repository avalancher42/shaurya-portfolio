<figure class="blueprint">
  <svg viewBox="0 0 760 460" role="img" aria-label="Blueprint sketch: a TRL-certified deep-tech firm borrows from a lender; the government guarantee fund pays 75% of losses in return for a 2.5% annual fee. In Year 1, premium income of Rs 75 crore sits against an expected payout of Rs 270 crore, a gap of Rs 195 crore." xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="bp-grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="#ffffff" stroke-opacity="0.07" stroke-width="1" /></pattern>
      <pattern id="bp-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="7" stroke="#ffffff" stroke-width="1.6" stroke-opacity="0.7" /></pattern>
      <filter id="bp-wob" x="-4%" y="-4%" width="108%" height="108%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="3" /></filter>
      <filter id="bp-wob-t" x="-4%" y="-4%" width="108%" height="108%"><feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="1" seed="3" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="1.3" /></filter>
      <marker id="bp-arrow" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="15" markerHeight="15" markerUnits="userSpaceOnUse" orient="auto"><path d="M2 2 L10 6 L2 10" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></marker>
    </defs>
    <rect width="760" height="460" fill="#003366" />
    <rect width="760" height="460" fill="url(#bp-grid)" />
    <g filter="url(#bp-wob)" fill="none" stroke="#ffffff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="24" y="70" width="150" height="84" rx="6" />
      <rect x="270" y="70" width="150" height="84" rx="6" />
      <rect x="590" y="70" width="146" height="84" rx="6" />
      <path d="M176 112 L266 112" marker-end="url(#bp-arrow)" />
      <path d="M422 100 L586 100" marker-end="url(#bp-arrow)" />
      <path d="M586 128 L424 128" marker-end="url(#bp-arrow)" />
      <path d="M60 420 L470 420" />
      <rect x="90" y="383" width="100" height="37" fill="url(#bp-hatch)" />
      <rect x="260" y="285" width="100" height="135" fill="url(#bp-hatch)" />
      <path d="M192 383 L432 383" stroke-dasharray="7 7" stroke-width="1.8" />
      <path d="M362 285 L432 285" stroke-dasharray="7 7" stroke-width="1.8" />
      <path d="M418 334 L418 290" marker-end="url(#bp-arrow)" />
      <path d="M418 334 L418 380" marker-end="url(#bp-arrow)" />
    </g>
    <g filter="url(#bp-wob-t)" class="bp-text">
      <text x="24" y="38" class="l">Fig. 1  How the guarantee works</text>
      <text x="99" y="108" text-anchor="middle" class="m">TRL-certified</text>
      <text x="99" y="132" text-anchor="middle" class="m">deep-tech firm</text>
      <text x="345" y="108" text-anchor="middle" class="m">Lender</text>
      <text x="345" y="132" text-anchor="middle" class="s">venture debt</text>
      <text x="663" y="108" text-anchor="middle" class="m">Government</text>
      <text x="663" y="132" text-anchor="middle" class="m">guarantee fund</text>
      <text x="221" y="100" text-anchor="middle" class="s">loan</text>
      <text x="504" y="88" text-anchor="middle" class="s">fee, 2.5% a year</text>
      <text x="505" y="150" text-anchor="middle" class="s">pays 75% of losses</text>
      <text x="24" y="200" class="s">Year-1 book in the model: 200 loans × Rs 15 Cr = Rs 3,000 Cr</text>
      <text x="140" y="374" text-anchor="middle" class="m b">Rs 75 Cr</text>
      <text x="140" y="444" text-anchor="middle" class="s">premium</text>
      <text x="310" y="276" text-anchor="middle" class="m b">Rs 270 Cr</text>
      <text x="310" y="444" text-anchor="middle" class="s">expected payout</text>
      <text x="436" y="340" class="l b">gap: Rs 195 Cr</text>
      <text x="520" y="262" class="s">base case: 15% default rate,</text>
      <text x="520" y="284" class="s">20% recovery on claims</text>
      <text x="520" y="392" class="s">fix: a higher fee, or a</text>
      <text x="520" y="412" class="s">subsidised early phase</text>
    </g>
  </svg>
  <figcaption>Blueprint: how the guarantee works, with the Year-1 numbers from the model.</figcaption>
</figure>
