---
import Layout from '../../layouts/Layout.astro';
import { researchPieces } from '../../data/research';
---
<Layout title="Research — Shaurya Vijay Sinha" description="Independent fiscal and policy case studies: an AI credit-guarantee proposal (ADSBG), a risk-pricing critique of CGTMSE, and a fiscal transfer framework.">
  <section class="section section--tight finance-blur-host reveal">
    <!-- Original, blurred abstract candlestick motif — drawn shapes, not a photo. -->
    <svg class="finance-blur" viewBox="0 0 360 220" width="420" height="260" style="top:-20px; right:-50px;" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <line x1="60" y1="30" x2="60" y2="190" stroke="var(--rule)" stroke-width="4" />
      <rect x="44" y="70" width="32" height="70" fill="var(--ink)" />
      <line x1="140" y1="50" x2="140" y2="170" stroke="var(--navy)" stroke-width="4" />
      <rect x="124" y="90" width="32" height="50" fill="var(--rule)" />
      <line x1="220" y1="20" x2="220" y2="180" stroke="var(--rule)" stroke-width="4" />
      <rect x="204" y="40" width="32" height="90" fill="var(--navy)" />
      <line x1="300" y1="60" x2="300" y2="200" stroke="var(--ink)" stroke-width="4" />
      <rect x="284" y="100" width="32" height="60" fill="var(--ink)" />
    </svg>
    <div class="wrap">
      <p class="eyebrow">Applied policy research</p>
      <h1>Research</h1>
      <p class="prose">
        Each piece below pairs an argument with the fiscal model behind it —
        developed independently, not yet published. The write-up is the case
        for the number; the download is the model that produced it.
      </p>
    </div>
  </section>

  <section class="section section--tight reveal">
    <div class="wrap">
      <div class="card-grid">
        {researchPieces.map((piece) => (
          <div class="card">
            <p class="eyebrow" style="margin-bottom:0.3em;">{piece.tag}</p>
            <h3>{piece.title}</h3>
            <p>{piece.description}</p>
            <p style="font-weight:700; color:var(--ink-strong);">{piece.keyFinding}</p>
            <a href={`/research/${piece.slug}/`}>Read the case study →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
