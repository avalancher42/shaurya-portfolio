---
import Layout from '../../layouts/Layout.astro';
import { researchPieces } from '../../data/research';
---
<Layout title="Research — Shaurya Vijay Sinha" description="Two fiscal exposure models written up as case studies: an AI credit-guarantee proposal (ADSBG) and a risk-pricing critique of CGTMSE.">
  <section class="section section--tight section-media reveal">
    <!-- Placeholder: drop a faint, desaturated ledger-paper or stock-ticker-tape
         texture at /public/images/bg-ledger.jpg — opacity (12%) and tint are
         already set. -->
    <div class="bg-photo" style="background-image:url('/images/bg-ledger.jpg');"></div>
    <div class="wrap">
      <p class="eyebrow">Applied policy research</p>
      <h1>Research</h1>
      <p class="prose">
        Each piece below pairs a published argument with the fiscal model behind
        it. The write-up is the case for the number; the download is the model
        that produced it.
      </p>
    </div>
  </section>

  <section class="section section--tight reveal">
    <div class="wrap">
      <div class="card-grid">
        {researchPieces.map((piece) => (
          <div class="card">
            <p class="eyebrow" style="margin-bottom:0.3em;">{piece.tag}</p>
            <h3>{piece.title}</h3>
            <p>{piece.description}</p>
            <p style="font-weight:700; color:var(--ink-strong);">{piece.keyFinding}</p>
            <a href={`/research/${piece.slug}/`}>Read the case study →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
