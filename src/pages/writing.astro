---
import Layout from '../layouts/Layout.astro';
import { researchPieces } from '../data/research';
import { publishedWriting } from '../data/writing';

const swarajya = 'https://swarajyamag.com/author/2460159/shaurya-vijay-sinha';
const substack = 'https://substack.com/@shauryavijaysinha';
---
<Layout title="Writing — Shaurya Vijay Sinha" description="Published economic and policy commentary by Shaurya Vijay Sinha, in Swarajya and on Substack.">
  <section class="section section--tight reveal">
    <div class="wrap">
      <p class="eyebrow">Published commentary</p>
      <h1>Writing</h1>
      <p class="prose">
        Argument-first commentary on growth, industrial policy, and economic
        history — usually built around a book, and usually ending somewhere a
        model can test. The case studies below have full write-ups and a
        downloadable model or deck of their own; everything else links out to
        Swarajya.
      </p>
    </div>
  </section>

  <section class="section section--tight reveal">
    <div class="wrap">
      <h2>In-depth case studies</h2>
      <ul class="piece-list">
        {researchPieces.map((piece) => (
          <li>
            <div>
              <div class="piece-title">{piece.title}</div>
              <div style="font-size:0.95rem;">{piece.description}</div>
            </div>
            <span class="piece-meta"><a href={`/research/${piece.slug}/`}>Read the case study →</a></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight reveal">
    <div class="wrap">
      <h2>On Swarajya</h2>
      <p style="margin-bottom:var(--space-2);">
        <a href={swarajya} target="_blank" rel="noopener noreferrer">View the full author page on Swarajya →</a>
      </p>
      <ul class="piece-list">
        {publishedWriting.map((piece) => (
          <li>
            <div>
              <div class="piece-title">
                <a href={piece.url} target="_blank" rel="noopener noreferrer">{piece.title}</a>
              </div>
              <div style="font-size:0.95rem;">{piece.description}</div>
            </div>
          </li>
        ))}
      </ul>
      <p style="margin-top:var(--space-2);">
        <a href={substack} target="_blank" rel="noopener noreferrer">Follow along on Substack →</a>
      </p>
    </div>
  </section>
</Layout>
