---
import Layout from '../layouts/Layout.astro';

const swarajya = 'https://swarajyamag.com/author/2460159/shaurya-vijay-sinha';
const substack = 'https://substack.com/@shauryavijaysinha';
---
<Layout title="Writing — Shaurya Vijay Sinha" description="Published economic and policy commentary by Shaurya Vijay Sinha, in Swarajya and on Substack.">
  <section class="section section--tight">
    <div class="wrap">
      <p class="eyebrow">Published commentary</p>
      <h1>Writing</h1>
      <p class="prose">
        Argument-first commentary on growth, industrial policy, and economic
        history — usually built around a book, and usually ending somewhere a
        model can test. The two research pieces below have full case-study
        write-ups and downloadable models of their own; everything else links
        out to where it was published.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Paired with a model</h2>
      <ul class="piece-list">
        <li>
          <div>
            <div class="piece-title">The Missing Guarantee</div>
            <div style="font-size:0.95rem;">A credit instrument for India's AI and deep-tech sector</div>
          </div>
          <span class="piece-meta"><a href="/research/the-missing-guarantee/">Read the case study →</a></span>
        </li>
        <li>
          <div>
            <div class="piece-title">The Plough and the Guarantee</div>
            <div style="font-size:0.95rem;">A Bastiat-and-Kautilya reading of CGTMSE's risk pricing</div>
          </div>
          <span class="piece-meta"><a href="/research/the-plough-and-the-guarantee/">Read the case study →</a></span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>On Swarajya</h2>
      <p style="margin-bottom:var(--space-2);">
        <a href={swarajya} target="_blank" rel="noopener noreferrer">View the full author page on Swarajya →</a>
      </p>
      <ul class="piece-list">
        <li>
          <div class="piece-title">A Sixth of Humanity</div>
          <span class="piece-meta">Critique of Subramanian &amp; Kapur, on Dutch Disease</span>
        </li>
        <li>
          <div class="piece-title">Capitalism with Chinese Characteristics</div>
          <span class="piece-meta">Review of Yasheng Huang — amplified by Huang on Substack</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Elsewhere</h2>
      <ul class="piece-list">
        <li>
          <div class="piece-title">Economic History of India</div>
          <span class="piece-meta">Commentary on Tirthankar Roy — labour absorption vs GDP</span>
        </li>
        <li>
          <div class="piece-title">A Culture of Growth</div>
          <span class="piece-meta">Review of Joel Mokyr</span>
        </li>
        <li>
          <div class="piece-title">Why Growth Matters</div>
          <span class="piece-meta">Review of Bhagwati &amp; Panagariya, for NDRB</span>
        </li>
      </ul>
      <p style="margin-top:var(--space-2);">
        <a href={substack} target="_blank" rel="noopener noreferrer">Follow along on Substack →</a>
      </p>
    </div>
  </section>
</Layout>
