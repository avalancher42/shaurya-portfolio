---
import Layout from '../layouts/Layout.astro';
import { caseCompetitions } from '../data/case-competitions';
---
<Layout
  title="Case Competitions — Shaurya Vijay Sinha"
  description="Case competition work: De Beers × Ashoka University Consulting Challenge, IIMB's National Student Case Competition, and SRCC's Maestro."
>
  <section class="section section--tight reveal">
    <div class="wrap">
      <p class="eyebrow">Competitive casework</p>
      <h1>Case Competitions</h1>
      <p class="prose">
        Independent case competition entries — each with a short brief and a
        download link to the full deck.
      </p>
    </div>
  </section>

  <section class="section section--tight reveal">
    <div class="wrap">
      <div class="card-grid">
        {caseCompetitions.map((entry) => (
          <div class="card">
            <p class="eyebrow" style="margin-bottom:0.3em;">{entry.eyebrow}</p>
            <h3>{entry.title}</h3>
            <p>{entry.description}</p>
            <a href={entry.fileHref} target="_blank" rel="noopener noreferrer">Download the deck (.pdf) →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
