---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — Shaurya Vijay Sinha" description="Get in touch with Shaurya Vijay Sinha by email or LinkedIn.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Get in touch</p>
      <h1>Contact</h1>
      <p class="prose" style="font-size:1.1rem;">
        Best reached by email or LinkedIn — happy to talk about the research,
        the models behind it, or roles in finance and investment banking.
      </p>

      <div class="card-grid" style="max-width:34rem; margin-top:var(--space-4);">
        <div class="card">
          <h3 style="font-size:1.05rem;">Email</h3>
          <p><a href="mailto:shauryavijaysinha@gmail.com">shauryavijaysinha@gmail.com</a></p>
        </div>
        <div class="card">
          <h3 style="font-size:1.05rem;">LinkedIn</h3>
          <p><a href="https://www.linkedin.com/in/shaurya-vijay-sinha/" target="_blank" rel="noopener noreferrer">/in/shaurya-vijay-sinha</a></p>
        </div>
      </div>
    </div>
  </section>
</Layout>
