---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — Shaurya Vijay Sinha" description="Get in touch with Shaurya Vijay Sinha by email, LinkedIn, or Substack.">
  <section class="section reveal">
    <div class="wrap">
      <p class="eyebrow">Get in touch</p>
      <h1>Let's talk</h1>
      <p class="prose" style="font-size:1.1rem;">
        Happy to talk about the research, the models behind it, or roles in
        finance and investment banking.
      </p>

      <div class="card-grid contact-cards" style="margin-top: var(--space-4);">
        <div class="card">
          <h3 style="font-size:1.05rem;">Email</h3>
          <p style="margin-bottom:0;"><a href="mailto:shauryavijaysinha@gmail.com">shauryavijaysinha@gmail.com</a></p>
        </div>
        <div class="card">
          <h3 style="font-size:1.05rem;">LinkedIn</h3>
          <p style="margin-bottom:0;"><a href="https://www.linkedin.com/in/shaurya-vijay-sinha/" target="_blank" rel="noopener noreferrer">/in/shaurya-vijay-sinha</a></p>
        </div>
        <div class="card">
          <h3 style="font-size:1.05rem;">Substack</h3>
          <p style="margin-bottom:0;"><a href="https://substack.com/@shauryavijaysinha" target="_blank" rel="noopener noreferrer">@shauryavijaysinha</a></p>
        </div>
      </div>
    </div>
  </section>
</Layout>
