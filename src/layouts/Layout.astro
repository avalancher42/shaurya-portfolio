---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Shaurya Vijay Sinha — B.Com (Hons) student, St. Xavier's College, Kolkata. Fiscal modelling, credit-guarantee policy research, and consulting casework en route to investment banking."
} = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/experience/', label: 'Experience' },
  { href: '/research/', label: 'Research' },
  { href: '/writing/', label: 'Writing' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5eedd" />
    <ClientRouter />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap masthead__row">
        <a href="/" class="brand">
          <span class="brand__mark">SVS</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main transition:animate="fade">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p style="margin:0;">© {new Date().getFullYear()} Shaurya Vijay Sinha.</p>
        <div class="footer-links">
          <a href="https://www.linkedin.com/in/shaurya-vijay-sinha/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://substack.com/@shauryavijaysinha" target="_blank" rel="noopener noreferrer">Substack</a>
          <a href="https://swarajyamag.com/author/2460159/shaurya-vijay-sinha" target="_blank" rel="noopener noreferrer">Swarajya</a>
          <a href="mailto:shauryavijaysinha@gmail.com">Email</a>
        </div>
      </div>
    </footer>

    <script>
      function initReveal() {
        const els = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      }

      function initCounters() {
        const prefersReduced =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const nodes = document.querySelectorAll('[data-count-to]');
        if (!nodes.length) return;

        const duration = 1100;

        const renderValue = (el, value) => {
          const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
          const prefix = el.getAttribute('data-prefix') || '';
          const suffix = el.getAttribute('data-suffix') || '';
          el.textContent = prefix + value.toFixed(decimals) + suffix;
        };

        const startCount = (el) => {
          const to = parseFloat(el.getAttribute('data-count-to') || '0');
          if (prefersReduced) {
            renderValue(el, to);
            return;
          }
          const runId = ((el._countRunId || 0) + 1);
          el._countRunId = runId;
          const start = performance.now();

          function tick(now) {
            if (el._countRunId !== runId) return; // superseded by a reset/restart
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            renderValue(el, to * progress);
            if (progress < 1) {
              requestAnimationFrame(tick);
            }
          }
          requestAnimationFrame(tick);
        };

        const resetCount = (el) => {
          el._countRunId = (el._countRunId || 0) + 1; // invalidate any running loop
          renderValue(el, 0);
        };

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                startCount(entry.target);
              } else {
                resetCount(entry.target);
              }
            });
          },
          { threshold: 0.4 }
        );
        nodes.forEach((el) => io.observe(el));
      }

      document.addEventListener('astro:page-load', () => {
        initReveal();
        initCounters();
      });
    </script>
  </body>
</html>
